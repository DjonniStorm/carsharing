# cp deploy/.env.prod.example deploy/.env.prod
# Один файл на VPS: compose + backend + build web. Не коммитить .env.prod.

# --- Домен / TLS ---
DOMAIN=carsharing-coursework.duckdns.org
CERTBOT_EMAIL=you@example.com

# --- Web build (Vite) ---
VITE_API_BASE_URL=https://carsharing-coursework.duckdns.org
VITE_YANDEX_MAPS_API_KEY=
VITE_OPEN_MANAGER_SELF_REGISTER=true

# --- Postgres ---
POSTGRES_USER=carsharing
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=carsharing
POSTGRES_PUBLISH_PORT=5432

# --- Backend: JWT ---
AUTH_TOKEN_SECRET=change-me-long-random
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=1d
AUTH_TOKEN_EXPIRES_IN=1d

# --- Backend: регистрация ---
# false + SMTP ниже = письмо с кодом verify-email
# true = JWT сразу, SMTP не обязателен
AUTH_SKIP_VERIFICATION=false
OPEN_MANAGER_SELF_REGISTER=true

# --- Backend: telemetry device API ---
TELEMETRY_DEVICE_KEY=change-me-telemetry-key
TELEMETRY_PERIOD_SEC=5

# --- Backend: SMTP (обязательно для писем, если AUTH_SKIP_VERIFICATION=false) ---
NOTIFICATION_EMAIL_HOST=smtp.yandex.ru
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_SECURE=false
NOTIFICATION_EMAIL_USER=your@yandex.ru
NOTIFICATION_EMAIL_PASSWORD=app-password-from-yandex
NOTIFICATION_EMAIL_FROM=CarSharing Service <your@yandex.ru>

# --- Backend: SMS Firebase Phone Auth (mobile Android, опционально) ---
# FIREBASE_API_KEY=

# --- Backend: нарушения (опционально, есть дефолты) ---
# VIOLATION_SPEED_LIMIT_KMH=90
# VIOLATION_LOW_FUEL_THRESHOLD=15
# VIOLATION_DEDUP_WINDOW_SEC=60

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=http://YOUR_VPS_IP:3001
GRAFANA_PUBLISH_PORT=3001
PROMETHEUS_PUBLISH_PORT=9090
