# Локальная разработка: cp .env.example .env
# Prod на VPS: всё в deploy/.env.prod (см. deploy/.env.prod.example)

# --- База (локально на хосте; в prod compose DATABASE_URL переопределяется на postgres:5432) ---
DATABASE_URL="postgresql://carsharing:carsharing@localhost:5432/carsharing?schema=public"
POSTGRES_USER="carsharing"
POSTGRES_PASSWORD="carsharing"
POSTGRES_DB="carsharing"

# --- JWT / auth ---
AUTH_TOKEN_SECRET="change-me-for-local-dev"
JWT_SECRET="carsharing-secret-key"
JWT_EXPIRES_IN="1d"
AUTH_TOKEN_EXPIRES_IN="1d"

# true — JWT сразу при регистрации
# false — isActive=false; код через POST /auth/send-verification-code (email и/или Firebase SMS)
# AUTH_SKIP_VERIFICATION="true"

# Публичные device-эндпоинты telemetry (заголовок x-telemetry-key)
TELEMETRY_DEVICE_KEY="dev-telemetry-key"

# Период throttle телеметрии (сек), по умолчанию 5
# TELEMETRY_PERIOD_SEC="5"

# Регистрация менеджера без JWT (должно совпадать с VITE_OPEN_MANAGER_SELF_REGISTER на web)
OPEN_MANAGER_SELF_REGISTER="true"

# --- Нарушения (опционально, есть дефолты в коде) ---
# VIOLATION_SPEED_LIMIT_KMH="90"
# VIOLATION_LOW_FUEL_THRESHOLD="15"
# VIOLATION_DEDUP_WINDOW_SEC="60"

# --- Grafana (сервис monitoring в deploy compose) ---
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"
GRAFANA_ROOT_URL="http://localhost:3001"

# --- Email SMTP (@carsharing/notification) ---
# Нужен для channel=email в POST /auth/send-verification-code
NOTIFICATION_EMAIL_HOST=""
NOTIFICATION_EMAIL_PORT="587"
NOTIFICATION_EMAIL_SECURE="false"
NOTIFICATION_EMAIL_USER=""
NOTIFICATION_EMAIL_PASSWORD=""
NOTIFICATION_EMAIL_FROM=""

# --- SMS Firebase Phone Auth (@carsharing/notification, mobile reCAPTCHA) ---
# Нужен для channel=sms в POST /auth/send-verification-code (recaptchaToken с клиента)
# FIREBASE_API_KEY=""

# --- Nest (опционально) ---
# PORT="3000"
