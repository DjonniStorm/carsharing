# Скопируйте в `.env` (не коммитить).

#  Тесты (Vitest) 
# cp .env.test.example .env.test
# pnpm db:up && pnpm db:create:test && pnpm test:setup
# pnpm test

#  Backend 
# Локальный запуск (на хосте) идёт по localhost; внутри docker-compose backend
# использует переменную DATABASE_URL из docker-compose.yml (с хостом `postgres`).
DATABASE_URL="postgresql://carsharing:carsharing@localhost:5432/carsharing?schema=public"

AUTH_TOKEN_SECRET="change-me-for-local-dev"

# true — сразу JWT при регистрации; false — письмо с кодом и POST /auth/verify-email (нужен SMTP ниже).
# AUTH_SKIP_VERIFICATION="true"

#  Postgres (docker-compose) 
POSTGRES_USER="carsharing"
POSTGRES_PASSWORD="carsharing"
POSTGRES_DB="carsharing"

#  Grafana 
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"
GRAFANA_ROOT_URL="http://localhost:3001"

#  Notifications (опционально, SMTP) 
NOTIFICATION_EMAIL_HOST=""
NOTIFICATION_EMAIL_PORT="587"
NOTIFICATION_EMAIL_SECURE="false"
NOTIFICATION_EMAIL_USER=""
NOTIFICATION_EMAIL_PASSWORD=""
NOTIFICATION_EMAIL_FROM=""
