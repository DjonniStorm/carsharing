# Скопируйте в `.env` в каталоге apps/web и подставьте значения.
# Документация: https://yandex.ru/dev/maps/jsapi/doc/3.0/quick-start/index.html
#
# Ключ пакета «JavaScript API и HTTP Геокодер»: https://developer.tech.yandex.ru/
# Для локальной разработки добавьте в кабинете ключа ограничение Referer: localhost
# (изменения применяются до ~15 минут).

# Базовый URL API (NestJS), без завершающего слэша. По умолчанию в коде: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# GitHub Pages project site: /имя-репозитория/ (со слэшами). Локальный деплой: не задавать или /
# VITE_BASE_PATH=/carsharing/

# Публичный ключ — попадает в бандл Vite (префикс VITE_).
VITE_YANDEX_MAPS_API_KEY=

# Совпадает с OPEN_MANAGER_SELF_REGISTER на Nest: разрешить выбор роли менеджер/водитель при регистрации.
# VITE_OPEN_MANAGER_SELF_REGISTER=true
